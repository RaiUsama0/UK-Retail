# --- Secrets / environment ---
.env
*.env.local

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.ruff_cache/
.pytest_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data (raw source + derived outputs are reproducible via the pipeline, not committed) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
Online Retail.xlsx

# --- Reports / logs ---
reports/*
!reports/.gitkeep
*.log

# --- Database ---
*.sqlite3
pgdata/

# --- Power BI (binary/generated, regenerable via `ingest-data export-powerbi`) ---
dashboards/powerbi/*.pbix.bak
dashboards/powerbi/data/*
!dashboards/powerbi/data/.gitkeep

# --- Streamlit public dataset (generated, regenerable via `ingest-data export-public`) ---
dashboards/streamlit/data/public/*.csv
dashboards/streamlit/data/public/_export_generated_at.txt
!dashboards/streamlit/data/public/README.md

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
